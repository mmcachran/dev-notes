Update at ~/.config/opencode/opencode.json

```json
{
  "$schema": "https://opencode.ai",
  "model": "ollama/qwen3-coder:latest",
  "share": "disabled",
  "autoupdate": true,
  "theme": "palenight",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "reserved": 4096
  },
  "instructions": [
    "rector.php",
    "pint.json",
    "CONTRIBUTING.md"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:latest": {
          "name": "qwen3-coder:latest",
          "options": {
            "textVerbosity": "low"
          }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "vendor/bin/pint*": "allow",
      "vendor/bin/rector*": "allow"
    },
    "read": "allow",
    "todowrite": "allow"
  }
}
```
