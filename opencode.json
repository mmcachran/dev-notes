Update at ~/.config/opencode/opencode.json

```json
{
  "$schema": "https://opencode.ai",
  "model": "ollama/qwen2.5-coder:7b",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "reserved": 2048
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "qwen2.5-coder:7b",
          "options": {
            "textVerbosity": "low",
            "temperature": 0.1,
            "num_ctx": 16384
          }
        }
      }
    }
  }
}
```
